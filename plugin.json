{
  "name": "ironmind",
  "version": "1.0.0",
  "description": "Behavioral intervention skill for reducing compulsive pornography consumption and masturbation. Action-first, low-shame, no moralizing. Includes IronBuddy proactive companion agent.",
  "homepage": "https://github.com/your-org/IronMind",
  "license": "MIT",
  "skills": [
    {
      "name": "ironmind",
      "path": "skills/ironmind/SKILL.md",
      "aliases": ["im"],
      "triggers": [
        "/ironmind",
        "/im",
        "ironmind",
        "I need help right now",
        "I gave in",
        "I relapsed",
        "active urge",
        "post relapse",
        "trigger map",
        "day check-in"
      ]
    }
  ],
  "agents": [
    {
      "name": "ironbuddy",
      "path": "agents/ironbuddy.md",
      "description": "Proactive companion agent. Sends scheduled check-ins, pre-window alerts, streak milestones, and post-relapse recovery pulses."
    }
  ],
  "hooks": [
    {
      "name": "session-check",
      "path": "hooks/session-check.md",
      "event": "SessionStart"
    },
    {
      "name": "schedule",
      "path": "hooks/schedule.md",
      "event": "Schedule"
    }
  ],
  "platforms": {
    "claude": {
      "skill": "skills/ironmind/SKILL.md",
      "references": "skills/ironmind/references/"
    },
    "cursor": {
      "rule": "cursor/rules/ironmind.mdc"
    },
    "vscode": {
      "instruction": "vscode/instructions/ironmind.instructions.md"
    },
    "codebuddy": {
      "skill": "codebuddy/ironmind/SKILL.md"
    },
    "codex": {
      "skill": "codex/ironmind/SKILL.md"
    }
  }
}
